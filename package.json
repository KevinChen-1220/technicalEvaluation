{
  "name": "dynamic-assessment-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "verify:web": "node scripts/verify-web-metadata.mjs",
    "verify:assets": "node scripts/verify-native-assets.mjs",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "dev:weapp": "npm --workspace apps/wechat run dev:weapp",
    "test:wechat": "npm --workspace apps/wechat run test",
    "typecheck:wechat": "npm --workspace apps/wechat run typecheck",
    "build:weapp": "npm --workspace apps/wechat run build:weapp"
  },
  "dependencies": {
    "@expo/metro-runtime": "~5.0.5",
    "expo": "~53.0.22",
    "expo-asset": "~11.1.7",
    "expo-secure-store": "~14.2.3",
    "expo-sqlite": "~15.2.14",
    "expo-status-bar": "~2.2.3",
    "jsonrepair": "^3.15.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.6",
    "react-native-safe-area-context": "5.4.0",
    "react-native-web": "~0.20.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "jest": "^29.7.0",
    "pngjs": "^7.0.0",
    "ts-jest": "^29.4.0",
    "typescript": "~5.8.3"
  }
}
