{
  "functionRoot": ".",
  "functions": [
    {
      "name": "create-generation-job",
      "dir": "./create-generation-job",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "get-generation-job",
      "dir": "./get-generation-job",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "get-assessment",
      "dir": "./get-assessment",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "update-assessment",
      "dir": "./update-assessment",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "list-assessments",
      "dir": "./list-assessments",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "complete-assessment",
      "dir": "./complete-assessment",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "get-user-settings",
      "dir": "./get-user-settings",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "update-user-settings",
      "dir": "./update-user-settings",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "create-report",
      "dir": "./create-report",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 15,
      "installDependency": true
    },
    {
      "name": "generation-worker",
      "dir": "./generation-worker",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 600,
      "installDependency": true,
      "triggers": [
        {
          "name": "generation-worker-every-minute",
          "type": "timer",
          "config": "0 */1 * * * * *"
        }
      ]
    },
    {
      "name": "retention-cleanup",
      "dir": "./retention-cleanup",
      "handler": "index.main",
      "runtime": "Nodejs20.19",
      "timeout": 120,
      "installDependency": true,
      "triggers": [
        {
          "name": "daily-retention-cleanup",
          "type": "timer",
          "config": "0 0 3 * * * *"
        }
      ]
    }
  ]
}
