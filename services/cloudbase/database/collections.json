{
  "schemaVersion": 1,
  "collections": [
    {
      "name": "generation_jobs",
      "documentSchemaVersion": 1,
      "required": ["_id", "_openid", "schemaVersion", "status", "progress", "request", "retryable", "attempt", "createdAt", "updatedAt", "expiresAt"],
      "properties": {
        "status": ["queued", "running", "completed", "failed"],
        "progress": "integer:0..100",
        "request": { "topic": "string", "notes": "string?", "questionCount": [50, 100] },
        "clientRequestId": "string?",
        "assessmentId": "string?",
        "errorCode": "safe-code?",
        "retryable": "boolean",
        "attempt": "integer",
        "leaseOwner": "string?",
        "leaseExpiresAt": "timestamp?"
      }
    },
    {
      "name": "assessments",
      "documentSchemaVersion": 1,
      "required": ["_id", "_openid", "schemaVersion", "status", "paper", "answers", "result", "revision", "createdAt", "updatedAt", "completedAt"],
      "properties": {
        "status": ["draft", "completed"],
        "paper": "AssessmentPaper",
        "answers": "Record<string, string[]>",
        "result": "AssessmentResult|null",
        "revision": "integer:>=1",
        "completedAt": "timestamp|null"
      }
    },
    {
      "name": "daily_generation_quotas",
      "documentSchemaVersion": 1,
      "required": ["_id", "_openid", "schemaVersion", "utcDay", "count", "createdAt", "updatedAt"],
      "properties": {
        "utcDay": "date:YYYY-MM-DD",
        "count": "integer:>=0"
      }
    },
    {
      "name": "generation_rate_limits",
      "documentSchemaVersion": 1,
      "required": ["_id", "_openid", "schemaVersion", "windowStartedAt", "expiresAt", "count", "createdAt", "updatedAt"],
      "properties": {
        "windowStartedAt": "timestamp",
        "expiresAt": "timestamp",
        "count": "integer:>=0"
      }
    },
    {
      "name": "user_settings",
      "documentSchemaVersion": 1,
      "required": ["_id", "_openid", "schemaVersion", "locale", "privacyConsentVersion", "privacyConsentAt", "createdAt", "updatedAt"],
      "properties": {
        "locale": ["zh-CN"],
        "displayPreferences": "DisplayPreferences?",
        "privacyConsentVersion": "string",
        "privacyConsentAt": "timestamp|null"
      }
    },
    {
      "name": "user_reports",
      "documentSchemaVersion": 1,
      "required": ["_id", "_openid", "schemaVersion", "assessmentId", "reason", "policyVersion", "status", "createdAt", "updatedAt"],
      "properties": {
        "assessmentId": "string",
        "reason": ["question_error", "content_safety", "privacy", "other"],
        "detail": "string?",
        "policyVersion": "string",
        "status": ["open"]
      }
    }
  ]
}
