{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@dynamic-assessment/assessment-core": ["packages/assessment-core/src"]
    }
  },
  "include": ["App.tsx", "src/**/*.ts", "src/**/*.tsx", "packages/**/*.ts"]
}
